{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stallpos-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "vars": {
    "GOOGLE_CLIENT_IDS": "",
    "DASHBOARD_GOOGLE_CLIENT_ID": "",
    "SENTRY_DSN": "",
    "EMAIL_FROM": ""
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "204201",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "204202",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "POS_DB",
      "database_name": "stallpos-pos",
      "migrations_dir": "migrations/pos"
    },
    {
      "binding": "DELETION_DB",
      "database_name": "stallpos-deletion",
      "migrations_dir": "migrations/deletion"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
