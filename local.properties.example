# Copy to local.properties (gitignored) and adjust paths.
#   cp local.properties.example local.properties
#
# Android SDK — required for Gradle / Android Studio
sdk.dir=/path/to/Android/sdk

# StallPOS v2 cloud (optional before the internal M8 release gate)
# syncBaseUrl=https://your-worker.example.workers.dev
# googleServerClientId=000000000000-example.apps.googleusercontent.com
# sentryDsn=https://public@example.ingest.sentry.io/project
# CI equivalents: STALLPOS_SYNC_BASE_URL, STALLPOS_GOOGLE_SERVER_CLIENT_ID,
# and STALLPOS_SENTRY_DSN

# 綠界贊助付款 URL：填入 app/.../ui/sponsor/SponsorLinks.kt（非本檔）
#   ECPAY_URL_TIER_SMALL / MEDIUM / LARGE

# Release signing (required for release builds; debug builds do not need these values)
# storeFile=/path/to/release.keystore
# storePassword=
# keyAlias=stallpos-release
# keyPassword=
# CI uses STALLPOS_RELEASE_STORE_FILE, STALLPOS_RELEASE_STORE_PASSWORD,
# STALLPOS_RELEASE_KEY_ALIAS, and STALLPOS_RELEASE_KEY_PASSWORD.
